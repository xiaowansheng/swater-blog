# ========================================
# Swater Blog 环境变量配置示例
# 复制此文件为 .env，并只填写外部连接、端口、账号、密码、邮箱、域名、Token、Key 等敏感或环境相关值。
# ========================================

# ========================================
# Docker Compose 入口
# ========================================
COMPOSE_PROFILES=http

# ========================================
# 服务端口
# ========================================
# Spring 激活的配置 profile
# 有效值: dev（本地开发）| docker（容器部署，默认）| prod（生产覆盖，需自备 application-prod.yml，已被 gitignore 忽略）
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8888
BLOG_SERVICE_PUBLISHED_PORT=8888
BLOG_ADMIN_PUBLISHED_PORT=3001
BLOG_WEB_PUBLISHED_PORT=3002
NGINX_HTTP_PUBLISHED_PORT=80
NGINX_HTTPS_PUBLISHED_PORT=443
ELASTICSEARCH_HTTP_PUBLISHED_PORT=9200

# RSS订阅
BLOG_SITE_URL=http://web.local
BLOG_RSS_DEFAULT_LOCALE=zh

# ========================================
# 初始管理员账号（首次启动创建，已存在则跳过）
# ========================================
# dev/docker 均从这里注入：三项必填，缺失则 blog-service 启动失败（fail-fast），
# 配置文件中不再有默认口令兜底。生产部署务必使用强密码 + 真实邮箱。
BLOG_ADMIN_USERNAME=admin
# 生成强密码示例：openssl rand -base64 18
BLOG_ADMIN_PASSWORD=please-change-this-to-a-strong-password
BLOG_ADMIN_EMAIL=admin@example.com

# ========================================
# Elasticsearch 搜索引擎配置（可选）
# ========================================
# 搜索插件：database=数据库 LIKE 搜索（默认）；elasticsearch=ES 全文搜索
# 启用 ES 步骤：
#   1) PLUGIN_SEARCH_ACTIVE=elasticsearch
#   2) ELASTICSEARCH_REPOSITORIES_ENABLED=true
#   3) ELASTICSEARCH_HEALTH_ENABLED=true（可选，开启 actuator ES 健康检查）
#   4) docker compose --profile elasticsearch up -d
PLUGIN_SEARCH_ACTIVE=database
ELASTICSEARCH_HOST=http://elasticsearch:9200
ELASTICSEARCH_REPOSITORIES_ENABLED=false
ELASTICSEARCH_HEALTH_ENABLED=false
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ========================================
# 数据库配置(MySQL)
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# ========================================
# Nginx / HTTPS 域名和邮箱
# ========================================
ALL_DOMAINS=admin.local,web.local
ACME_EMAIL=admin@example.com
NGINX_ADMIN_DOMAIN=admin.local
NGINX_WEB_DOMAIN=web.local


# ========================================
# Redis 缓存配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
# Redis 密码（docker-compose.yml 部署必填；dev/env 本地开发可为空）
REDIS_PASSWORD=change_me_redis_password
REDIS_DATABASE=0

# ========================================
# 端口绑定地址（安全默认：仅本机访问）
# 数据库/缓存/MQ/后端等端口默认只绑 127.0.0.1，经 nginx 反代对外；
# 确需局域网/公网直连时改为 0.0.0.0，并自行确保防火墙与强口令
# ========================================
DB_HOST_BIND=127.0.0.1
REDIS_HOST_BIND=127.0.0.1
RABBITMQ_HOST_BIND=127.0.0.1
ELASTICSEARCH_HOST_BIND=127.0.0.1
BLOG_SERVICE_HOST_BIND=127.0.0.1
BLOG_ADMIN_HOST_BIND=127.0.0.1
BLOG_WEB_HOST_BIND=127.0.0.1

# ========================================
# RabbitMQ 消息队列配置
# ========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PUBLISHED_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_me_rabbitmq_password
RABBITMQ_VHOST=/

# ========================================
# 监控栈端口
# ========================================
PROMETHEUS_PUBLISHED_PORT=9090
GRAFANA_PUBLISHED_PORT=3000
ALERTMANAGER_PUBLISHED_PORT=9093
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
NODE_EXPORTER_PUBLISHED_PORT=9100
MYSQL_EXPORTER_PUBLISHED_PORT=9104
REDIS_EXPORTER_PUBLISHED_PORT=9121

# ========================================
# 监控告警邮件配置
# ========================================
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM=blog-alerts@yourdomain.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=admin@yourdomain.com
ALERT_EMAIL_CRITICAL=admin@yourdomain.com
ALERT_EMAIL_WARNING=admin@yourdomain.com

# ========================================
# MySQL 监控专用凭据（可选，生产环境建议创建只读用户而非使用 root）
# CREATE USER 'monitor'@'%' IDENTIFIED BY 'xxx';
# GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'monitor'@'%';
# ========================================
MYSQL_EXPORTER_USER=root
MYSQL_EXPORTER_PASSWORD=change_me_root_password

# ========================================
# 邮件配置（QQ邮箱 SMTP）
# ========================================
MAIL_USERNAME=
MAIL_PASSWORD=

# ========================================
# 安全密钥（生产环境务必填写）
# ========================================
# Sa-Token JWT 签名密钥（强随机字符串，泄露后需轮换）
SA_TOKEN_JWT_SECRET_KEY=
# 前台评论验证会话密钥（强随机字符串，未设置时邮件验证/密码重置功能将不可用）
AUTH_EMAIL_SESSION_SECRET=
# ISR 按需重验证令牌（与 blog-web 端 REVALIDATE_TOKEN 保持一致，生产环境请替换为强随机值）
REVALIDATE_TOKEN=replace_with_a_long_random_value
# 仅填写实际反向代理 IP/CIDR；留空时后端忽略 X-Forwarded-For/X-Real-IP
SECURITY_TRUSTED_PROXIES=
# 生产环境请改为实际前端域名，逗号分隔；默认仅允许本地开发来源
SECURITY_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
# HTTPS 部署设为 true：登录 token（httpOnly Cookie）增加 Secure 标志。
# 注意：httpOnly Cookie + SameSite=Strict 要求前端与 /api、/ws 同域（经 Nginx 反代），
# 浏览器直连后端端口会导致 Cookie 不携带、登录态丢失。
SA_TOKEN_COOKIE_SECURE=false

# ========================================
# 第三方服务 API Key
# ========================================
# 高德地图 IP 定位 Key（https://lbs.amap.com/）
AMAP_KEY=
# 阿里云 OSS（可选）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 七牛云存储（可选）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
