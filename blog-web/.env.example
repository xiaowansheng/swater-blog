# Copy to .env.local for local development when needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8888
SERVER_API_BASE_URL=http://localhost:8888
NEXT_PUBLIC_UPLOAD_RESOURCE_PREFIX=http://localhost:8888/uploads
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# ISR 按需重验证令牌（与后端 revalidate.token 保持一致，生产环境请使用强随机值）
REVALIDATE_TOKEN=replace_with_a_long_random_value
